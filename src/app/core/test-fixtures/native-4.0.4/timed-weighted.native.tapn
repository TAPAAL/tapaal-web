        </structure>
      </type>
    </place>
    <place displayName="true" id="Block" initialMarking="0" invariant="&lt; 7" name="Block" nameOffsetX="0" nameOffsetY="0" positionX="300" positionY="200">
      <type>
        <text>dot</text>
        <structure>
          <usersort declaration="dot"/>
        </structure>
      </type>
    </place>
    <transition angle="90" displayName="true" distribution="constant" firingMode="Random" id="Go" infiniteServer="false" name="Go" nameOffsetX="12" nameOffsetY="-4" player="0" positionX="195" positionY="60" priority="0" urgent="false" value="1.0" weight="1.0"/>
    <transition angle="0" displayName="true" distribution="constant" firingMode="Random" id="Now" infiniteServer="false" name="Now" nameOffsetX="0" nameOffsetY="0" player="0" positionX="195" positionY="200" priority="0" urgent="true" value="1.0" weight="1.0"/>
    <arc id="A0" inscription="(1,5):1" nameOffsetX="0" nameOffsetY="0" source="Start" target="Go" transportID="1" type="transport" weight="2">
      <hlinscription>
        <text>2'dot</text>
        <structure>
          <numberof>
            <subterm>
              <numberconstant value="2">
                <positive/>
              </numberconstant>
            </subterm>
            <subterm>
              <useroperator declaration="dot"/>
            </subterm>
          </numberof>
        </structure>
      </hlinscription>
      <arcpath arcPointType="false" id="0" xCoord="105" yCoord="75"/>
      <arcpath arcPointType="true" id="1" xCoord="150" yCoord="20"/>
      <arcpath arcPointType="false" id="2" xCoord="210" yCoord="75"/>
    </arc>
    <arc id="A1" inscription="(1,5):1" nameOffsetX="0" nameOffsetY="0" source="Go" target="Moved" transportID="1" type="transport" weight="2">
      <hlinscription>
        <text>2'dot</text>
        <structure>
          <numberof>
            <subterm>
              <numberconstant value="2">
                <positive/>
              </numberconstant>
            </subterm>
            <subterm>
              <useroperator declaration="dot"/>
            </subterm>
          </numberof>
        </structure>
      </hlinscription>
      <arcpath arcPointType="false" id="0" xCoord="210" yCoord="75"/>
      <arcpath arcPointType="false" id="1" xCoord="255" yCoord="135"/>
      <arcpath arcPointType="true" id="2" xCoord="315" yCoord="75"/>
    </arc>
    <arc id="A2" inscription="[2,inf)" nameOffsetX="0" nameOffsetY="0" source="Moved" target="Go" type="timed" weight="3">
      <hlinscription>
        <text>3'dot</text>
        <structure>
