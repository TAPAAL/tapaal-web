    </arc>
    <arc id="I3" inscription="[0,inf)" nameOffsetX="0" nameOffsetY="0" source="Block" target="Now" type="tapnInhibitor" weight="4">
      <arcpath arcPointType="false" id="0" xCoord="315" yCoord="215"/>
      <arcpath arcPointType="false" id="1" xCoord="210" yCoord="210"/>
    </arc>
    <arc id="A4" inscription="1" nameOffsetX="0" nameOffsetY="0" source="Now" target="Block" type="normal" weight="5">
      <hlinscription>
        <text>5'dot</text>
        <structure>
          <numberof>
